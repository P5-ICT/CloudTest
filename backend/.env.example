# Supabase → Project Settings → Database → Connection string → URI
# (use the "Transaction pooler" URI on Render; port is usually 6543 there,
# or 5432 for a direct connection — either works, pooler is safer on a small plan)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# Passcode the facilitator dashboard sends as the X-Admin-Passcode header.
ADMIN_PASSCODE=CloudLead2026

# Your deployed frontend's origin(s), comma-separated. Use * only for local testing.
FRONTEND_ORIGIN=https://your-frontend.onrender.com
